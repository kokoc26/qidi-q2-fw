#!/bin/sh
# QIDI DNS hook - 海外策略（APAC / EEA / NA / Others 共用）
# 打包期由 build.sh 按 REGION 选一份安装为 /etc/dhcpcd.exit-hook，本地修改会被下次升级覆盖

# 强制注入安全环境变量
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# 本区域公网保底 DNS：空格分隔，由下面的 for 循环逐项拆开
FALLBACK_DNS="1.1.1.1 8.8.8.8"
DNS_POLICY_TAG="GLOBAL"

# 当网络设备（eth0/wlan0）成功绑定IP、重启或续租时触发
if [ "$reason" = "BOUND" ] || [ "$reason" = "REBOOT" ] || [ "$reason" = "RENEW" ]; then

    # 初始化内存变量
    RAW_DNS_LIST=""

    # 顺位 1：加入 DHCP 真正下发的企业内网 DNS
    if [ -n "$new_domain_name_servers" ]; then
        for ns in $new_domain_name_servers; do
            RAW_DNS_LIST="${RAW_DNS_LIST}${ns}\n"
        done
    fi

    # 顺位 2：本区域的公网保底 DNS
    for ns in $FALLBACK_DNS; do
        RAW_DNS_LIST="${RAW_DNS_LIST}${ns}\n"
    done

    # 去重并截取前 4 个：上限 4 是为了让 DHCP 下发 2 个 DNS 时保底项仍能被写入
    FINAL_NAMESERVERS=$(printf "$RAW_DNS_LIST" | awk '!seen[$0]++' | head -n 4)

    # 一次性覆盖 /etc/resolv.conf，单次闪存写入
    echo "# Automatically generated by QIDI dhcpcd-hook (Smart-Multi-DNS, policy=$DNS_POLICY_TAG)" > /etc/resolv.conf

    for ip in $FINAL_NAMESERVERS; do
        if [ -n "$ip" ]; then
            echo "nameserver $ip" >> /etc/resolv.conf
        fi
    done

    chmod 644 /etc/resolv.conf
fi
